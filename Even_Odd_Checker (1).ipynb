        "print(\"EVEN OR ODD CHECKER\")\n",
        "\n",
        "number = int(input(\"Enter a number: \"))\n",
        "\n",
        "if number % 2 == 0:\n",
        "    print(number, \"is an EVEN number\")\n",
        "else:\n",
        "    print(number, \"is an ODD number\")"
