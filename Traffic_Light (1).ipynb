      "source": [
        "print(\"TRAFFIC LIGHT SYSTEM\")\n",
        "\n",
        "signal = input(\"Enter traffic signal (red/yellow/green): \").lower()\n",
        "\n",
        "if signal == \"red\":\n",
        "    print(\"STOP\")\n",
        "elif signal == \"yellow\":\n",
        "    print(\"GET READY\")\n",
        "elif signal == \"green\":\n",
        "    print(\"GO\")\n",
        "else:\n",
        "    print(\"Invalid signal\")\n"
      ]
    }
